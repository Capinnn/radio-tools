# Copy to secrets.env (gitignored), chmod 600, and replace this placeholder.
ICECAST_SOURCE_PASSWORD=replace-with-a-long-random-value

# Optional. If omitted, start.sh uses ICECAST_SOURCE_PASSWORD for these roles.
# ICECAST_ADMIN_PASSWORD=replace-with-another-long-random-value
# ICECAST_RELAY_PASSWORD=replace-with-another-long-random-value

# Public name advertised by Icecast. This does not control the listen address.
ICECAST_HOSTNAME=radio.example.invalid
ICECAST_PORT=8000

